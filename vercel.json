{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/evaluate.py": {
      "includeFiles": "{data/ada2026_prescription_kb.json,src/**}",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "framework": null,
  "outputDirectory": "public"
}
